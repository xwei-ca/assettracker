# Reduce the size of the image file, build inside the container, ship only the runtime.
# ---- Stage 1: Build ----
FROM eclipse-temurin:17-jdk AS builder
WORKDIR /build

# Copy Maven wrapper and pom first (better layer caching)
COPY mvnw .
COPY .mvn .mvn
COPY pom.xml .

# Download dependencies (cached unless pom.xml changes)
RUN ./mvnw dependency:go-offline -B

# Copy source and build
COPY src src
RUN ./mvnw clean package -DskipTests -B

# ---- Stage 2: Runtime ----
FROM eclipse-temurin:17-jre
RUN useradd -m appuser
USER appuser
WORKDIR /app

COPY --from=builder /build/target/assettracker-0.0.1-SNAPSHOT.jar app.jar

EXPOSE 8080
ENTRYPOINT ["java", "-jar", "app.jar"]